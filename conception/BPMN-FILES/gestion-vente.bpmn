<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Vente_v2" targetNamespace="https://example.org/erp/gestion-vente">
  <bpmn:process id="Process_Vente" name="Gestion de vente : scénario paramétrable" isExecutable="false">
    <bpmn:startEvent id="Start" name="Demande client reçue">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Demande" name="Enregistrer la demande">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="StockReq" name="Vérification du stock nécessaire ?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="StockMerge">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Stock" name="Consulter la disponibilité">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Disponible" name="Produits disponibles ?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Informer" name="Informer le client et examiner les options">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Attendre" name="Le client souhaite attendre ?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Cancel" name="Demande abandonnée">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="AchatActive" name="Intégration Achat active ?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Achat" name="Transmettre une demande à Gestion d’achat">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ManuelAchat" name="Organiser le réapprovisionnement externe">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AchatMerge">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Pending" name="Mettre la demande en attente">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="StockRecu" name="Notification de disponibilité reçue">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_StockRecu" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="VenteMerge">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="DevisReq" name="Devis requis ?">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Devis" name="Préparer et envoyer le devis">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Accept" name="Devis accepté ?">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Rejected" name="Devis refusé">
      <bpmn:incoming>Flow_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="CommandeMerge">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Commande" name="Enregistrer et confirmer la commande">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Physical" name="Livraison physique nécessaire ?">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="LogActive" name="Intégration Logistique active ?">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Log" name="Transmettre la commande à Logistique">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="LogManual" name="Organiser la livraison hors module Logistique">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="LogMerge">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="DeliveryMerge">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Billing" name="Établir la facture selon la politique choisie">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AccountingActive" name="Intégration Comptabilité active ?">
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Accounting" name="Transmettre la facture à Comptabilité">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AccountingManual" name="Organiser le traitement comptable externe">
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AccountingMerge">
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:incoming>Flow_38</bpmn:incoming>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End" name="Traitement commercial terminé">
      <bpmn:incoming>Flow_39</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Demande" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Demande" targetRef="StockReq" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="StockReq" targetRef="StockMerge" name="Oui" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="StockReq" targetRef="VenteMerge" name="Non" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="StockMerge" targetRef="Stock" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Stock" targetRef="Disponible" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Disponible" targetRef="VenteMerge" name="Oui" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Disponible" targetRef="Informer" name="Non" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Informer" targetRef="Attendre" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Attendre" targetRef="Cancel" name="Non" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Attendre" targetRef="AchatActive" name="Oui" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="AchatActive" targetRef="Achat" name="Oui" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="AchatActive" targetRef="ManuelAchat" name="Non" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Achat" targetRef="AchatMerge" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="ManuelAchat" targetRef="AchatMerge" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="AchatMerge" targetRef="Pending" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Pending" targetRef="StockRecu" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="StockRecu" targetRef="StockMerge" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="VenteMerge" targetRef="DevisReq" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="DevisReq" targetRef="Devis" name="Oui" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="DevisReq" targetRef="CommandeMerge" name="Non" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Devis" targetRef="Accept" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Accept" targetRef="Rejected" name="Non" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Accept" targetRef="CommandeMerge" name="Oui" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="CommandeMerge" targetRef="Commande" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Commande" targetRef="Physical" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Physical" targetRef="DeliveryMerge" name="Non" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Physical" targetRef="LogActive" name="Oui" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="LogActive" targetRef="Log" name="Oui" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="LogActive" targetRef="LogManual" name="Non" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Log" targetRef="LogMerge" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="LogManual" targetRef="LogMerge" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="LogMerge" targetRef="DeliveryMerge" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="DeliveryMerge" targetRef="Billing" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Billing" targetRef="AccountingActive" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="AccountingActive" targetRef="Accounting" name="Oui" />
    <bpmn:sequenceFlow id="Flow_36" sourceRef="AccountingActive" targetRef="AccountingManual" name="Non" />
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Accounting" targetRef="AccountingMerge" />
    <bpmn:sequenceFlow id="Flow_38" sourceRef="AccountingManual" targetRef="AccountingMerge" />
    <bpmn:sequenceFlow id="Flow_39" sourceRef="AccountingMerge" targetRef="End" />
  </bpmn:process>
