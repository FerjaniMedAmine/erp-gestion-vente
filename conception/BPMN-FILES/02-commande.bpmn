<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs" targetNamespace="https://example.org/erp/ventes">
  <bpmn:process id="Processus" name="Gestion des commandes" isExecutable="false">
    <bpmn:startEvent id="s" name="Commande à traiter">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="c" name="Saisir ou importer la commande">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="v" name="Contrôler client, articles et conditions">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:incoming>F4</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g" name="Données valides ?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="corr" name="Corriger ou compléter la commande">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="conf" name="Confirmer la commande">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="phys" name="Livraison physique requise ?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="int" name="Logistique intégrée ?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="send" name="Transmettre la commande à Logistique">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="manual" name="Organiser le traitement manuel">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="join">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="finaljoin">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="status" name="Suivre les statuts et préparer la facturation">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="Commande suivie">
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s" targetRef="c" />
    <bpmn:sequenceFlow id="F1" sourceRef="c" targetRef="v" />
    <bpmn:sequenceFlow id="F2" sourceRef="v" targetRef="g" />
    <bpmn:sequenceFlow id="F3" sourceRef="g" targetRef="corr" name="Non" />
    <bpmn:sequenceFlow id="F4" sourceRef="corr" targetRef="v" />
    <bpmn:sequenceFlow id="F5" sourceRef="g" targetRef="conf" name="Oui" />
    <bpmn:sequenceFlow id="F6" sourceRef="conf" targetRef="phys" />
    <bpmn:sequenceFlow id="F7" sourceRef="phys" targetRef="finaljoin" name="Non" />
    <bpmn:sequenceFlow id="F8" sourceRef="phys" targetRef="int" name="Oui" />
    <bpmn:sequenceFlow id="F9" sourceRef="int" targetRef="send" name="Oui" />
    <bpmn:sequenceFlow id="F10" sourceRef="int" targetRef="manual" name="Non" />
    <bpmn:sequenceFlow id="F11" sourceRef="send" targetRef="join" />
    <bpmn:sequenceFlow id="F12" sourceRef="manual" targetRef="join" />
    <bpmn:sequenceFlow id="F13" sourceRef="join" targetRef="finaljoin" />
    <bpmn:sequenceFlow id="F14" sourceRef="finaljoin" targetRef="status" />
    <bpmn:sequenceFlow id="F15" sourceRef="status" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Processus">
      <bpmndi:BPMNShape id="S_s" bpmnElement="s">
        <dc:Bounds x="50" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_c" bpmnElement="c">
        <dc:Bounds x="130" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_v" bpmnElement="v">
        <dc:Bounds x="350" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_g" bpmnElement="g">
        <dc:Bounds x="570" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_corr" bpmnElement="corr">
        <dc:Bounds x="690" y="50" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_conf" bpmnElement="conf">
        <dc:Bounds x="690" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_phys" bpmnElement="phys">
        <dc:Bounds x="910" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_int" bpmnElement="int">
        <dc:Bounds x="1030" y="310" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_send" bpmnElement="send">
        <dc:Bounds x="1150" y="260" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_manual" bpmnElement="manual">
        <dc:Bounds x="1150" y="390" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_join" bpmnElement="join">
        <dc:Bounds x="1370" y="310" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_finaljoin" bpmnElement="finaljoin">
        <dc:Bounds x="1480" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_status" bpmnElement="status">
        <dc:Bounds x="1580" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_end" bpmnElement="end">
        <dc:Bounds x="1800" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E0" bpmnElement="F0">
        <di:waypoint x="86" y="210" />
        <di:waypoint x="130" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E1" bpmnElement="F1">
        <di:waypoint x="290" y="210" />
        <di:waypoint x="350" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E2" bpmnElement="F2">
        <di:waypoint x="510" y="210" />
        <di:waypoint x="570" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E3" bpmnElement="F3">
        <di:waypoint x="595" y="185" />
        <di:waypoint x="595" y="90" />
        <di:waypoint x="690" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E4" bpmnElement="F4">
        <di:waypoint x="770" y="50" />
        <di:waypoint x="770" y="10" />
        <di:waypoint x="430" y="10" />
        <di:waypoint x="430" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E5" bpmnElement="F5">
        <di:waypoint x="620" y="210" />
        <di:waypoint x="690" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E6" bpmnElement="F6">
        <di:waypoint x="850" y="210" />
        <di:waypoint x="910" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E7" bpmnElement="F7">
        <di:waypoint x="960" y="210" />
        <di:waypoint x="1480" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E8" bpmnElement="F8">
        <di:waypoint x="935" y="235" />
        <di:waypoint x="935" y="335" />
        <di:waypoint x="1030" y="335" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E9" bpmnElement="F9">
        <di:waypoint x="1080" y="335" />
        <di:waypoint x="1110" y="335" />
        <di:waypoint x="1110" y="300" />
        <di:waypoint x="1150" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E10" bpmnElement="F10">
        <di:waypoint x="1055" y="360" />
        <di:waypoint x="1055" y="430" />
        <di:waypoint x="1150" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E11" bpmnElement="F11">
        <di:waypoint x="1310" y="300" />
        <di:waypoint x="1395" y="300" />
        <di:waypoint x="1395" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E12" bpmnElement="F12">
        <di:waypoint x="1310" y="430" />
        <di:waypoint x="1395" y="430" />
        <di:waypoint x="1395" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E13" bpmnElement="F13">
        <di:waypoint x="1420" y="335" />
        <di:waypoint x="1505" y="335" />
        <di:waypoint x="1505" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E14" bpmnElement="F14">
        <di:waypoint x="1530" y="210" />
        <di:waypoint x="1580" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E15" bpmnElement="F15">
        <di:waypoint x="1740" y="210" />
        <di:waypoint x="1800" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>