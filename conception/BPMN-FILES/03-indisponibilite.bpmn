<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs" targetNamespace="https://example.org/erp/ventes">
  <bpmn:process id="Processus" name="Produit indisponible" isExecutable="false">
    <bpmn:startEvent id="s" name="Rupture constatée">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="info" name="Informer le client des options">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="wait" name="Client accepte d’attendre ?">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="endno" name="Demande abandonnée">
      <bpmn:incoming>F2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="integr" name="Achat intégré ?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="send" name="Envoyer une demande à Achat">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ext" name="Organiser un approvisionnement externe">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="join">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="pending" name="Mettre la demande en attente">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="msg" name="Disponibilité signalée">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_msg" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="check" name="Vérifier à nouveau la disponibilité">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="available" name="Produits disponibles ?">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="continue" name="Reprendre le traitement commercial">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s" targetRef="info" />
    <bpmn:sequenceFlow id="F1" sourceRef="info" targetRef="wait" />
    <bpmn:sequenceFlow id="F2" sourceRef="wait" targetRef="endno" name="Non" />
    <bpmn:sequenceFlow id="F3" sourceRef="wait" targetRef="integr" name="Oui" />
    <bpmn:sequenceFlow id="F4" sourceRef="integr" targetRef="send" name="Oui" />
    <bpmn:sequenceFlow id="F5" sourceRef="integr" targetRef="ext" name="Non" />
    <bpmn:sequenceFlow id="F6" sourceRef="send" targetRef="join" />
    <bpmn:sequenceFlow id="F7" sourceRef="ext" targetRef="join" />
    <bpmn:sequenceFlow id="F8" sourceRef="join" targetRef="pending" />
    <bpmn:sequenceFlow id="F9" sourceRef="pending" targetRef="msg" />
    <bpmn:sequenceFlow id="F10" sourceRef="msg" targetRef="check" />
    <bpmn:sequenceFlow id="F11" sourceRef="check" targetRef="available" />
    <bpmn:sequenceFlow id="F12" sourceRef="available" targetRef="continue" name="Oui" />
    <bpmn:sequenceFlow id="F13" sourceRef="available" targetRef="info" name="Non" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Processus">
      <bpmndi:BPMNShape id="S_s" bpmnElement="s">
        <dc:Bounds x="50" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_info" bpmnElement="info">
        <dc:Bounds x="130" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_wait" bpmnElement="wait">
        <dc:Bounds x="350" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_endno" bpmnElement="endno">
        <dc:Bounds x="357" y="315" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_integr" bpmnElement="integr">
        <dc:Bounds x="470" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_send" bpmnElement="send">
        <dc:Bounds x="590" y="65" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_ext" bpmnElement="ext">
        <dc:Bounds x="590" y="290" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_join" bpmnElement="join">
        <dc:Bounds x="810" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_pending" bpmnElement="pending">
        <dc:Bounds x="910" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_msg" bpmnElement="msg">
        <dc:Bounds x="1130" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_check" bpmnElement="check">
        <dc:Bounds x="1240" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_available" bpmnElement="available">
        <dc:Bounds x="1460" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_continue" bpmnElement="continue">
        <dc:Bounds x="1600" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E0" bpmnElement="F0">
        <di:waypoint x="86" y="210" />
        <di:waypoint x="130" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E1" bpmnElement="F1">
        <di:waypoint x="290" y="210" />
        <di:waypoint x="350" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E2" bpmnElement="F2">
        <di:waypoint x="375" y="235" />
        <di:waypoint x="375" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E3" bpmnElement="F3">
        <di:waypoint x="400" y="210" />
        <di:waypoint x="470" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E4" bpmnElement="F4">
        <di:waypoint x="495" y="185" />
        <di:waypoint x="495" y="105" />
        <di:waypoint x="590" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E5" bpmnElement="F5">
        <di:waypoint x="495" y="235" />
        <di:waypoint x="495" y="330" />
        <di:waypoint x="590" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E6" bpmnElement="F6">
        <di:waypoint x="750" y="105" />
        <di:waypoint x="835" y="105" />
        <di:waypoint x="835" y="185" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E7" bpmnElement="F7">
        <di:waypoint x="750" y="330" />
        <di:waypoint x="835" y="330" />
        <di:waypoint x="835" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E8" bpmnElement="F8">
        <di:waypoint x="860" y="210" />
        <di:waypoint x="910" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E9" bpmnElement="F9">
        <di:waypoint x="1070" y="210" />
        <di:waypoint x="1130" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E10" bpmnElement="F10">
        <di:waypoint x="1166" y="210" />
        <di:waypoint x="1240" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E11" bpmnElement="F11">
        <di:waypoint x="1400" y="210" />
        <di:waypoint x="1460" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E12" bpmnElement="F12">
        <di:waypoint x="1510" y="210" />
        <di:waypoint x="1600" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E13" bpmnElement="F13">
        <di:waypoint x="1485" y="185" />
        <di:waypoint x="1485" y="20" />
        <di:waypoint x="210" y="20" />
        <di:waypoint x="210" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>