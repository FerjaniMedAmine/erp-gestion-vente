<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs" targetNamespace="https://example.org/erp/ventes">
  <bpmn:process id="Processus" name="Gestion des devis" isExecutable="false">
    <bpmn:startEvent id="start" name="Demande de devis reçue">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="saisie" name="Saisir client, articles et quantités">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="calcul" name="Calculer prix, remises et taxes">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="verif" name="Approbation requise ?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="appr" name="Demander l’approbation du responsable">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="accord" name="Remise approuvée ?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="revoir" name="Revoir les conditions du devis">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="join">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="envoi" name="Envoyer le devis au client">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="reponse" name="Réponse du client reçue">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_reponse" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="decision" name="Devis accepté ?">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="commande" name="Créer une commande à partir du devis">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endok" name="Commande préparée">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endnon" name="Devis refusé">
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="start" targetRef="saisie" />
    <bpmn:sequenceFlow id="F1" sourceRef="saisie" targetRef="calcul" />
    <bpmn:sequenceFlow id="F2" sourceRef="calcul" targetRef="verif" />
    <bpmn:sequenceFlow id="F3" sourceRef="verif" targetRef="appr" name="Oui" />
    <bpmn:sequenceFlow id="F4" sourceRef="verif" targetRef="join" name="Non" />
    <bpmn:sequenceFlow id="F5" sourceRef="appr" targetRef="accord" />
    <bpmn:sequenceFlow id="F6" sourceRef="accord" targetRef="join" name="Oui" />
    <bpmn:sequenceFlow id="F7" sourceRef="accord" targetRef="revoir" name="Non" />
    <bpmn:sequenceFlow id="F8" sourceRef="revoir" targetRef="calcul" />
    <bpmn:sequenceFlow id="F9" sourceRef="join" targetRef="envoi" />
    <bpmn:sequenceFlow id="F10" sourceRef="envoi" targetRef="reponse" />
    <bpmn:sequenceFlow id="F11" sourceRef="reponse" targetRef="decision" />
    <bpmn:sequenceFlow id="F12" sourceRef="decision" targetRef="commande" name="Oui" />
    <bpmn:sequenceFlow id="F13" sourceRef="decision" targetRef="endnon" name="Non" />
    <bpmn:sequenceFlow id="F14" sourceRef="commande" targetRef="endok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Processus">
      <bpmndi:BPMNShape id="S_start" bpmnElement="start">
        <dc:Bounds x="40" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_saisie" bpmnElement="saisie">
        <dc:Bounds x="120" y="180" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_calcul" bpmnElement="calcul">
        <dc:Bounds x="340" y="180" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_verif" bpmnElement="verif">
        <dc:Bounds x="560" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_appr" bpmnElement="appr">
        <dc:Bounds x="680" y="60" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_accord" bpmnElement="accord">
        <dc:Bounds x="900" y="75" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_revoir" bpmnElement="revoir">
        <dc:Bounds x="1020" y="25" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_join" bpmnElement="join">
        <dc:Bounds x="1120" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_envoi" bpmnElement="envoi">
        <dc:Bounds x="1220" y="180" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_reponse" bpmnElement="reponse">
        <dc:Bounds x="1440" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_decision" bpmnElement="decision">
        <dc:Bounds x="1550" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_commande" bpmnElement="commande">
        <dc:Bounds x="1670" y="110" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_endok" bpmnElement="endok">
        <dc:Bounds x="1890" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_endnon" bpmnElement="endnon">
        <dc:Bounds x="1557" y="325" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E0" bpmnElement="F0">
        <di:waypoint x="76" y="220" />
        <di:waypoint x="120" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E1" bpmnElement="F1">
        <di:waypoint x="280" y="220" />
        <di:waypoint x="340" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E2" bpmnElement="F2">
        <di:waypoint x="500" y="220" />
        <di:waypoint x="560" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E3" bpmnElement="F3">
        <di:waypoint x="585" y="195" />
        <di:waypoint x="585" y="100" />
        <di:waypoint x="680" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E4" bpmnElement="F4">
        <di:waypoint x="610" y="220" />
        <di:waypoint x="1120" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E5" bpmnElement="F5">
        <di:waypoint x="840" y="100" />
        <di:waypoint x="900" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E6" bpmnElement="F6">
        <di:waypoint x="925" y="125" />
        <di:waypoint x="925" y="220" />
        <di:waypoint x="1120" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E7" bpmnElement="F7">
        <di:waypoint x="950" y="100" />
        <di:waypoint x="985" y="100" />
        <di:waypoint x="985" y="65" />
        <di:waypoint x="1020" y="65" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E8" bpmnElement="F8">
        <di:waypoint x="1100" y="25" />
        <di:waypoint x="1100" y="5" />
        <di:waypoint x="420" y="5" />
        <di:waypoint x="420" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E9" bpmnElement="F9">
        <di:waypoint x="1170" y="220" />
        <di:waypoint x="1220" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E10" bpmnElement="F10">
        <di:waypoint x="1380" y="220" />
        <di:waypoint x="1440" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E11" bpmnElement="F11">
        <di:waypoint x="1476" y="220" />
        <di:waypoint x="1550" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E12" bpmnElement="F12">
        <di:waypoint x="1575" y="195" />
        <di:waypoint x="1575" y="150" />
        <di:waypoint x="1670" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E13" bpmnElement="F13">
        <di:waypoint x="1575" y="245" />
        <di:waypoint x="1575" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E14" bpmnElement="F14">
        <di:waypoint x="1830" y="150" />
        <di:waypoint x="1890" y="150" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>